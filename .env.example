# Postgres. Locally: a docker container, or the same free-tier database the
# deployment uses. SQLite was swapped out on 2026-08-03 for the Vercel deploy —
# see ADR-0001 and docs/DEPLOYING.md.
DATABASE_URL="postgresql://user:password@host:5432/tuenx?sslmode=require"

API_PORT=5174

# Off anywhere but localhost. While on, every route opens with no credentials
# and anyone who reaches the server is an admin. The endpoint also refuses
# non-loopback addresses, so leaving it on in production locks everyone out
# rather than letting everyone in.
AUTH_BYPASS=true

# Adds `Secure` to the session cookie. Required over HTTPS, impossible on
# http://localhost — hence a switch rather than a default.
COOKIE_SECURE=false

# Optional. Raises the GitHub issue sync from 60 requests an hour to 5,000 and
# makes private repositories readable.
GITHUB_TOKEN=
