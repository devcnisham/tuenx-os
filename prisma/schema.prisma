// Tuenx OS — data model.
//
// Maps 1:1 onto TRD §2 (Phase 1) and TRD §3 Phase 2. See
// docs/adr/0001-sqlite-from-phase-1.md for why this is SQLite rather than the
// artifact key-value store in TRD §4, and for the list of divergences.
//
// Swapping to Postgres/Supabase (TRD Phase 9) is a two-line change here:
//   provider = "postgresql"  +  a new DATABASE_URL.
// Nothing in this schema uses a SQLite-only feature. Enum-typed fields from the
// TRD are `String` because Prisma has no native enum on SQLite; the allowed
// values live in src/types.ts and are shared by client and server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres since 2026-08-03, for the Vercel deploy. ADR-0001 named this as
  // the destination and promised it would be `provider` plus `DATABASE_URL`;
  // it was. No application code changed — the enums were already TypeScript
  // unions validated at the API boundary rather than database enums, which is
  // the thing that would otherwise have made this a rewrite.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1 — Overview, Tasks, CRM, Team
// ---------------------------------------------------------------------------

/// TRD §2 Task. `assignee` is a relation rather than the TRD's untyped field —
/// see ADR-0001. Nullable, so an unassigned task is still valid.
model Task {
  id         String      @id @default(cuid())
  tag        String      @unique
  title      String
  division   String // tuenx | agency | gaphatch
  status     String // todo | in_progress | done
  priority   String // low | medium | high
  assigneeId String?
  assignee   TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Phase 3. Nullable: most tasks are standalone, and Tuenx/Gaphatch tasks
  // never belong to an Agency project. Set null on project delete so the work
  // survives the container.
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dueDate    DateTime?

  /// Subtasks. Self-relation rather than a separate model — a subtask has
  /// every property a task has, and splitting them would mean maintaining two
  /// of everything. One level deep is enforced in the API: a tree nobody can
  /// see the bottom of is worse than a flat list.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")

  /// Epics group related work across projects. Nullable — most tasks aren't
  /// part of one.
  epicId String?
  epic   Epic?   @relation(fields: [epicId], references: [id], onDelete: SetNull)

  /// Sprints are optional. A team that doesn't run sprints leaves this null
  /// and nothing about the board changes.
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  /// Rough estimate in hours. Null means unestimated, which is different from
  /// zero and should stay tellable apart.
  estimateHours Float?

  createdAt DateTime @default(now())

  timeEntries TimeEntry[]

  @@index([division])
  @@index([status])
  @@index([assigneeId])
  @@index([projectId])
  @@index([parentId])
  @@index([epicId])
  @@index([sprintId])
}

/// A body of work spanning many tasks, often across projects.
model Epic {
  id        String   @id @default(cuid())
  tag       String   @unique
  title     String
  division  String // tuenx | agency | gaphatch
  status    String // open | in_progress | done | dropped
  notes     String?
  createdAt DateTime @default(now())

  tasks Task[]

  @@index([division])
  @@index([status])
}

/// A time-boxed run. Dates rather than a number of weeks, because teams skip
/// weeks and a computed end date would lie about when the sprint actually ran.
model Sprint {
  id        String   @id @default(cuid())
  tag       String   @unique
  name      String
  division  String // tuenx | agency | gaphatch
  startDate DateTime
  endDate   DateTime
  goal      String?
  status    String // planned | active | closed
  createdAt DateTime @default(now())

  tasks Task[]

  @@index([division])
  @@index([status])
}

/// Logged time against a task.
///
/// Stored as separate entries rather than a running total on the task, so the
/// log can say who spent the time and on what day. A single `hoursSpent`
/// column cannot answer either question.
model TimeEntry {
  id        String      @id @default(cuid())
  taskId    String
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  memberId  String?
  member    TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  hours     Float
  date      DateTime
  note      String?
  createdAt DateTime    @default(now())

  @@index([taskId])
  @@index([memberId])
  @@index([date])
}

/// TRD §2 Contact (CRM), plus the Phase 3 contract fields from TRD §3.
/// The Phase 3 additions were pure field additions, exactly as the TRD
/// sequencing promised — no restructuring of anything above.
model Contact {
  id      String  @id @default(cuid())
  tag     String  @unique
  name    String
  company String?
  division String // tuenx | agency | gaphatch
  stage   String // lead | proposal | active | closed
  value   Float   @default(0)
  email   String?
  notes   String?

  // Phase 3 — contract terms
  contractType  String? // retainer | project
  contractValue Float?
  startDate     DateTime?
  endDate       DateTime?

  createdAt DateTime @default(now())

  projects Project[]
  invoices Invoice[]
  account  ClientAccount?

  @@index([division])
  @@index([stage])
}

/// TRD §3 Phase 3 Project — wraps a client, a contract, and tasks into one
/// trackable unit (PRD §6). Division is inherited from the contact rather
/// than stored again, so a project can never disagree with its client.
model Project {
  id        String    @id @default(cuid())
  tag       String    @unique
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title     String
  status    String // kickoff | build | qa | handoff | support | closed
  /// Stalled, usually on client sign-off. A flag rather than a status because
  /// work stalls *from* a stage and has to come back to it — see ADR-0002.
  onHold    Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  tasks    Task[]
  invoices Invoice[]

  @@index([contactId])
  @@index([status])
}

/// TRD §3 Phase 3 Invoice. `projectId` is an addition — the TRD hangs invoices
/// off the contact only, but PRD §7 has an invoice attached to a project, and
/// an Agency client can run several projects at once. Nullable, so a
/// contact-level invoice is still valid.
model Invoice {
  id        String   @id @default(cuid())
  tag       String   @unique
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amount    Float
  status    String // draft | sent | paid | overdue
  issueDate DateTime
  dueDate   DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([projectId])
  @@index([status])
}

/// TRD §2 TeamMember. `tag` is an ADR-0001 addition (TRD omits it; the build
/// brief requires a division-coded tag on every record).
model TeamMember {
  id        String   @id @default(cuid())
  tag       String   @unique
  name      String
  role      String
  division  String // tuenx | agency | gaphatch
  /// Functional team — engineering, design, marketing, people, finance, ops,
  /// sales, support, leadership.
  ///
  /// Orthogonal to division on purpose. Division says which arm of the group
  /// pays for someone; team says what they do. An Agency designer and a
  /// Gaphatch designer are the same craft in different arms, and collapsing
  /// the two axes would lose that.
  ///
  /// Nullable, because not everyone slots neatly into one and forcing a choice
  /// produces worse data than admitting the gap.
  team      String?
  email     String?
  createdAt DateTime @default(now())

  tasks           Task[]
  leaveRequests   LeaveRequest[]
  ownedVendors    Vendor[]
  channelMembers  ChannelMember[]
  messages        Message[]
  timeEntries     TimeEntry[]
  account         UserAccount?

  @@index([division])
}

// ---------------------------------------------------------------------------
// Phase 2 — Gaphatch Products
// ---------------------------------------------------------------------------

/// TRD §3 Phase 2 Product. No `division` column: products are Gaphatch-only per
/// the master plan module map, so every product tag is GPH-P###.
model Product {
  id          String   @id @default(cuid())
  tag         String   @unique
  name        String
  status      String // planning | building | live
  description String?
  /// Where the product actually lives — the live site, or the staging URL
  /// while it is still building. A link, not an embed.
  url         String?
  /// Where its code lives. Kept separate from `url` because the two are read
  /// by different people for different reasons.
  repoUrl     String?
  createdAt   DateTime @default(now())

  roadmapItems RoadmapItem[]
  releases     Release[]
  objectives   Objective[]
  campaigns    Campaign[]
  tickets      Ticket[]
  metrics      MetricSnapshot[]
  customers    Customer[]
  planItems    PlanItem[]

  @@index([status])
}

/// TRD §3 Phase 2 RoadmapItem.
model RoadmapItem {
  id        String   @id @default(cuid())
  tag       String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  status    String // backlog | building | shipped
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([status])
}

/// TRD §3 Phase 2 Release. The TRD gives this a `date` and no `createdAt`;
/// kept as specified.
model Release {
  id        String   @id @default(cuid())
  tag       String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version   String
  notes     String?
  date      DateTime

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Phase 4 — Tuenx treasury
// ---------------------------------------------------------------------------

/// TRD §3 Phase 4 FundEntry.
///
/// Tuenx is the parent/holding entity, so this is where group money is
/// recorded: income and expense per division, plus `allocation` — capital
/// moved from the Tuenx level into a division. Runway is computed from these,
/// not stored.
model FundEntry {
  id       String   @id @default(cuid())
  tag      String   @unique
  division String // tuenx | agency | gaphatch
  type     String // income | expense | allocation
  amount   Float
  category String
  date     DateTime
  notes    String?

  @@index([division])
  @@index([type])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Phase 5 — OKRs and Docs
// ---------------------------------------------------------------------------

/// TRD §3 Phase 5 Objective.
///
/// `scope` is the TRD's union of a division or a productId. Stored as two
/// columns instead of one overloaded string: `scopeKind` says which it is, and
/// `productId` is a real foreign key when it is a product. A single column
/// would have meant string-sniffing a cuid to tell "gaphatch" from an id.
model Objective {
  id        String   @id @default(cuid())
  tag       String   @unique
  scopeKind String // division | product
  division  String // tuenx | agency | gaphatch — the owning arm either way
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  period    String // e.g. 2026-Q3
  owner     String?
  createdAt DateTime @default(now())

  keyResults KeyResult[]
  planItems  PlanItem[]

  @@index([division])
  @@index([period])
  @@index([productId])
}

/// TRD §3 Phase 5 KeyResult. Progress is derived from current vs target, not
/// stored, so the two can never disagree.
model KeyResult {
  id           String    @id @default(cuid())
  tag          String    @unique
  objectiveId  String
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  title        String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String? // %, users, $, …
  status       String // on_track | at_risk | off_track | done
  createdAt    DateTime  @default(now())

  @@index([objectiveId])
}

/// TRD §3 Phase 5 Doc — SOPs, playbooks, onboarding, policies.
model Doc {
  id        String   @id @default(cuid())
  tag       String   @unique
  title     String
  division  String // tuenx | agency | gaphatch
  category  String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([division])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Calendar — entries people create, alongside the derived deadlines
// ---------------------------------------------------------------------------

/// An event or reminder someone put on the calendar themselves.
///
/// The calendar also projects deadlines out of tasks, projects, invoices,
/// releases, and contracts — those are derived and read-only. This model is
/// only for entries that have no other home: a meeting, a holiday, a "chase
/// this" reminder.
///
/// Times are stored as `HH:mm` strings rather than as part of the timestamp.
/// The group is in one place and these are wall-clock times; storing an
/// instant would invite timezone conversion on a 10am standup that is 10am
/// wherever you read it.
model CalendarEntry {
  id       String   @id @default(cuid())
  tag      String   @unique
  title    String
  notes    String?
  division String // tuenx | agency | gaphatch
  kind     String // event | reminder | meeting | holiday
  date     DateTime
  /// Optional end date, for entries that span days. Null means single-day.
  endDate  DateTime?
  allDay   Boolean  @default(true)
  startTime String? // HH:mm, ignored when allDay
  endTime   String? // HH:mm, ignored when allDay
  /// Free text — there are no per-person accounts until Phase 9.
  attendees String?
  /// Minutes before the start to surface it. Null means no reminder.
  remindMinutesBefore Int?
  createdAt DateTime @default(now())

  @@index([division])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Planning — brainstorms and the quarter planner
// ---------------------------------------------------------------------------

/// A raw idea, before anyone has committed to it.
///
/// Deliberately separate from PlanItem. Mixing "someone mentioned this once"
/// with "we are doing this in Q3" is what makes planning boards untrustworthy —
/// people stop writing ideas down because writing one down looks like a
/// commitment. An idea graduates by being promoted, which creates a PlanItem
/// and links back here.
model Idea {
  id        String   @id @default(cuid())
  tag       String   @unique
  title     String
  body      String?
  division  String // tuenx | agency | gaphatch
  status    String // raw | shortlisted | parked | promoted
  author    String?
  /// Rough interest signal. Not a vote count per person — there are no
  /// per-person accounts until Phase 9.
  votes     Int      @default(0)
  createdAt DateTime @default(now())

  planItem PlanItem?

  @@index([division])
  @@index([status])
}

/// Something planned into a period. The unit the planner moves around.
model PlanItem {
  id       String @id @default(cuid())
  tag      String @unique
  title    String
  division String // tuenx | agency | gaphatch
  /// Free text, matching Objective.period — 2026-Q3, 2026-H2, whatever the
  /// group actually runs.
  period   String
  status   String // planned | committed | in_progress | done | dropped
  /// Rough size, not an estimate in hours. s | m | l
  effort   String
  owner    String?
  notes    String?

  /// Optional links to what this plan item serves.
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Set when promoted from a brainstorm, so provenance survives.
  ideaId String? @unique
  idea   Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([division])
  @@index([period])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 6 — People, ops, marketing
// ---------------------------------------------------------------------------

/// TRD §3 Phase 6 Candidate. `division` is an addition — every other record in
/// this system is division-tagged, and a hire is always for one arm.
model Candidate {
  id        String   @id @default(cuid())
  tag       String   @unique
  name      String
  role      String
  division  String // tuenx | agency | gaphatch
  stage     String // applied | screening | interview | offer | hired | passed
  source    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([division])
  @@index([stage])
}

/// TRD §3 Phase 6 LeaveRequest. Time-off tracking only — explicitly not
/// payroll, per master plan §4.
model LeaveRequest {
  id        String     @id @default(cuid())
  tag       String     @unique
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      String // holiday | sick | unpaid | parental
  startDate DateTime
  endDate   DateTime
  status    String // requested | approved | declined
  notes     String?
  createdAt DateTime   @default(now())

  @@index([memberId])
  @@index([status])
}

/// TRD §3 Phase 6 Vendor — what is paid for, when it renews, who owns it.
model Vendor {
  id          String      @id @default(cuid())
  tag         String      @unique
  name        String
  division    String // tuenx | agency | gaphatch
  monthlyCost Float       @default(0)
  renewalDate DateTime?
  ownerId     String?
  owner       TeamMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime    @default(now())

  @@index([division])
  @@index([ownerId])
}

/// TRD §3 Phase 6 Campaign. Same scope split as Objective — a campaign runs
/// for a division or for one specific Gaphatch product.
model Campaign {
  id        String   @id @default(cuid())
  tag       String   @unique
  scopeKind String // division | product
  division  String // tuenx | agency | gaphatch
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  channel   String
  status    String // planned | live | done
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([division])
  @@index([status])
  @@index([productId])
}

/// TRD §3 Phase 6 Contract — the company-wide repository, distinct from the
/// per-client contract terms that live on Contact.
///
/// `fileRef` is a path or URL, not an upload. File storage is out of scope for
/// this phase and pretending otherwise would be worse than a link.
model Contract {
  id        String    @id @default(cuid())
  tag       String    @unique
  party     String
  division  String // tuenx | agency | gaphatch
  type      String // client | vendor | employment | other
  value     Float     @default(0)
  startDate DateTime?
  endDate   DateTime?
  fileRef   String?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([division])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Phase 7 — Gaphatch customer-facing
// ---------------------------------------------------------------------------

/// TRD §3 Phase 7 Ticket. Activates once a product is live (master plan §3).
model Ticket {
  id              String    @id @default(cuid())
  tag             String    @unique
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Free-text fallback for a reporter who isn't a tracked customer.
  customerContact String?
  subject         String
  body            String?
  /// bug | issue | feature — see TICKET_KINDS. Bugs and feature requests share
  /// one queue because they compete for the same week of the same engineer.
  kind            String    @default("bug")
  status          String // open | pending | resolved
  priority        String // low | medium | high
  /// Where this came from, when it was not typed here — `gh:1234` for GitHub
  /// issue 1234. Unique per product, so re-syncing updates rather than
  /// duplicates.
  externalId      String?
  externalUrl     String?
  createdAt       DateTime  @default(now())

  @@unique([productId, externalId])
  @@index([productId])
  @@index([status])
  @@index([customerId])
}

/// TRD §3 Phase 7 MetricSnapshot — a point-in-time reading per product, not a
/// running total. Trends are derived by comparing snapshots.
model MetricSnapshot {
  id          String   @id @default(cuid())
  tag         String   @unique
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date        DateTime
  mrr         Float    @default(0)
  activeUsers Int      @default(0)
  churnRate   Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([productId, date])
  @@index([productId])
}

/// TRD §3 Phase 7 Customer — the subscriber base, per product.
model Customer {
  id                 String   @id @default(cuid())
  tag                String   @unique
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  subscriptionStatus String // trial | active | churned
  since              DateTime
  createdAt          DateTime @default(now())

  tickets Ticket[]

  @@index([productId])
  @@index([subscriptionStatus])
}

// ---------------------------------------------------------------------------
// Messaging
//
// Originally an explicit non-goal (master plan §4, PRD §4) on the grounds that
// Slack covers chat. Reversed by the founder on 2026-08-02 — see master plan
// §7. The reasoning for the reversal: Slack cannot attach a conversation to a
// record. A thread about AGY-I004 belongs on the invoice, not in a channel
// where it is lost a week later.
// ---------------------------------------------------------------------------

/// A channel, or a direct message between two people.
///
/// `recordType`/`recordId` optionally bind a channel to one record, which is
/// the whole reason this exists rather than deferring to Slack. Polymorphic for
/// the same reason RecordLink is — see the note there.
model Channel {
  id       String  @id @default(cuid())
  tag      String  @unique
  name     String
  purpose  String?
  division String // tuenx | agency | gaphatch
  kind     String // channel | dm | record
  archived Boolean @default(false)

  /// Set when the channel is the conversation about one specific record.
  recordType String?
  recordId   String?

  createdAt DateTime @default(now())

  members  ChannelMember[]
  messages Message[]

  @@index([division])
  @@index([kind])
  @@index([recordType, recordId])
}

/// Who is in a channel. Without per-person accounts (Phase 9) this is
/// membership for display and DM addressing, not access control.
model ChannelMember {
  id        String     @id @default(cuid())
  channelId String
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Last time this person opened the channel, for the unread count.
  lastReadAt DateTime?

  @@unique([channelId, memberId])
  @@index([memberId])
}

/// One message. No tag: tags are for records a person refers to by name, and
/// nobody says "see TNX-X001 message 47".
model Message {
  id        String      @id @default(cuid())
  channelId String
  channel   Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String?
  author    TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  /// Set when edited, so the UI can say so rather than silently rewriting.
  editedAt  DateTime?
  createdAt DateTime    @default(now())

  @@index([channelId, createdAt])
}

// ---------------------------------------------------------------------------
// Cross-record links
// ---------------------------------------------------------------------------

/// A link between any two records — a meeting to its agenda doc, a task to the
/// objective it serves, a project to the SOP that governs it.
///
/// Polymorphic rather than a foreign key per pair. There are already a dozen
/// record types; a dedicated column for every combination would be over a
/// hundred, and every new type would mean touching all of them. The cost is
/// that the database cannot enforce the target exists, so the API resolves and
/// validates both ends on write, and reads skip anything that has since been
/// deleted.
///
/// Links are undirected in meaning but stored with a direction, so the UI can
/// say "agenda for" rather than only "related to". Both ends are queried, so a
/// link shows up on both records regardless of which side created it.
model RecordLink {
  id       String @id @default(cuid())
  fromType String // task | contact | member | product | project | invoice | doc | objective | entry | plan | idea
  fromId   String
  toType   String
  toId     String
  /// Optional label for what the link means — "agenda", "blocks", "supersedes".
  note     String?

  createdAt DateTime @default(now())

  @@unique([fromType, fromId, toType, toId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

// ---------------------------------------------------------------------------
// Accounts and sessions
//
// TRD Phase 9 put authentication last. The founder pulled it forward on
// 2026-08-02 along with a client-facing portal, which PRD §4 had ruled out.
// Both reversals are recorded in master plan §7.
// ---------------------------------------------------------------------------

/// A team member's login. One per TeamMember, so the roster stays the single
/// list of who exists and an account is something a person *has*, not is.
model UserAccount {
  id       String     @id @default(cuid())
  memberId String     @unique
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  email    String @unique
  username String @unique

  /// scrypt. `passwordHash` is the derived key, `passwordSalt` the per-account
  /// salt — both hex. Never store or log anything recoverable.
  passwordHash String
  passwordSalt String

  /// PRD §5 roles. Not enforced anywhere yet beyond admin-only account
  /// management; the rest of the permission model is still Phase 9 work.
  role   String // admin | lead | member
  active Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  sessions Session[]
}

/// A client's login. No password, by the founder's explicit instruction —
/// possession of the email address is the whole credential.
///
/// That is an authentication bypass by design: anyone who knows a client's
/// email can read that client's invoices, projects, and contract value. It is
/// acceptable only while this runs on localhost. Adding a code or password
/// means one more column here and one more check in the login route; nothing
/// else has to change.
model ClientAccount {
  id        String  @id @default(cuid())
  contactId String  @unique
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  email  String  @unique
  active Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  sessions Session[]
}

/// A logged-in session.
///
/// Server-side rather than a self-contained signed token, so revoking access is
/// a delete rather than waiting for an expiry. At this scale the extra lookup
/// per request costs nothing.
model Session {
  id    String @id @default(cuid())
  /// Random, high-entropy, and the only thing the cookie carries.
  token String @unique
  kind  String // team | client

  userAccountId String?
  userAccount   UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userAccountId])
  @@index([clientAccountId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Phase 9 — audit trail
// ---------------------------------------------------------------------------

/// Who changed what, when. TRD §9, and the last piece of Phase 9.
///
/// Deliberately has no division tag. Every other record carries one because
/// people refer to it by name; nobody says "go and look at TNX-?012". An audit
/// row is evidence, not a record you cite — which is also why it sidesteps the
/// exhausted tag-letter alphabet entirely.
///
/// The actor's name and role are denormalised on purpose. A log that says
/// "account 7f3a deleted the Halcyon contract" is worthless once account 7f3a
/// is gone, and deleting the account is exactly what someone covering their
/// tracks would do.
model AuditEntry {
  id   String   @id @default(cuid())
  at   DateTime @default(now())

  actorId   String?
  actorName String
  actorRole String

  /// create | update | delete | sign_in | sign_in_failed | sign_out | portal_access
  action String
  /// The API resource — `tasks`, `invoices`, … or `auth` for session events.
  resource String

  recordId  String?
  recordTag String?

  /// Field-level diff, `{ field: { from, to } }`. Null for creates and deletes,
  /// where the whole record is the change.
  changes Json?

  ip String?

  @@index([at])
  @@index([resource, recordId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

/// Backs the division-coded ID tags (AGY-T003, GPH-C012).
///
/// One row per (division, type) pair, holding the next unissued sequence
/// number. Allocation happens inside a transaction in server/tags.ts, so two
/// concurrent creates cannot be handed the same tag — this closes the
/// client-generated-ID collision risk noted in TRD §4 ahead of Phase 9.
model TagCounter {
  division String // TNX | AGY | GPH
  /// One letter per record type — see TAG_TYPE in src/types.ts.
  type     String
  next     Int    @default(1)

  @@id([division, type])
}
